# Optional: `pnpm seed-env` reads the SOURCE_<n>_* / DEST_<n>_* values below (n = 1, 2, ...; the
# unindexed SOURCE_* / DEST_* form works too) and creates or updates those instances in the vault.
# The server never reads them; after seeding they live inside ./data/vault.enc.
#
# Re-seeding updates the instance with the same LABEL (or, if you renamed it in the UI, the same API key
# and FOLDER_ID). A blank value never clears something already stored: change or clear fields in the UI.
# BASE_URL must be an https:// URL (http:// only for localhost). A block with no API_KEY is skipped.
# If there is no vault yet, seed-env asks twice for a passphrase and creates one.
#
# .env is also loaded by the server, the dev proxy and the CLI scripts for these optional settings
# (real environment variables win over .env):
# VAULT_PATH=./data/vault.enc
# DB_PATH=./data/migrator.db
# PORT=5174
# LOG_LEVEL=info
# VAULT_PASSPHRASE='...'   # CLI scripts only (single-quote it: unquoted, dotenv cuts the value at the first #); the server never reads it
#
# FOLDER_ID  = UUID used to list / delete docs in that folder
# FOLDER_PATH = slash-separated folder name path used as import target (Omni requires path, not id)

SOURCE_1_LABEL=QA
SOURCE_1_BASE_URL=https://qa.omniapp.co
SOURCE_1_API_KEY=
SOURCE_1_USER_ID=
SOURCE_1_MODEL_ID=
SOURCE_1_FOLDER_ID=
SOURCE_1_FOLDER_PATH=

DEST_1_LABEL=AU
DEST_1_BASE_URL=https://au.omniapp.co
DEST_1_API_KEY=
DEST_1_USER_ID=
DEST_1_MODEL_ID=
DEST_1_FOLDER_ID=
DEST_1_FOLDER_PATH=

DEST_2_LABEL=UK
DEST_2_BASE_URL=https://uk.omniapp.co
DEST_2_API_KEY=
DEST_2_USER_ID=
DEST_2_MODEL_ID=
DEST_2_FOLDER_ID=
DEST_2_FOLDER_PATH=
